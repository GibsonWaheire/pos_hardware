# Copy to .env and fill in values

# Database — defaults to local SQLite
DATABASE_URL=sqlite:///pos_hardware.db

# Cloud DB for sync (PostgreSQL)
CLOUD_DATABASE_URL=postgresql://user:pass@host/dbname

# Flask
SECRET_KEY=change-me-in-production
FLASK_ENV=development

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stripe Terminal
STRIPE_SECRET_KEY=sk_test_...
STRIPE_TERMINAL_LOCATION=tml_...

# Hardware
# Receipt printer connection: network | usb | serial
PRINTER_TYPE=network
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
# PRINTER_USB_VENDOR=0x04b8
# PRINTER_USB_PRODUCT=0x0202
# PRINTER_SERIAL_PORT=/dev/ttyUSB0

# Cash drawer serial port (triggered via printer or direct serial)
CASH_DRAWER_PORT=/dev/ttyUSB0

# Store info for receipts
STORE_NAME=My Store
STORE_ADDRESS=123 Main St
STORE_PHONE=555-0100
STORE_TAX_ID=TAX-123456
